# Copie ce fichier en .env et colle ta propre cle :
#     cp .env.example .env
#
# .env est ignore par git (verifie dans .gitignore). Ne le commite jamais.
# La cle se cree sur https://platform.openai.com/api-keys
#
# ⚠️ Avant tout deploiement public : pose un plafond de depense sur le compte
# OpenAI (Settings -> Limits -> hard limit). Sans plafond, chaque visiteur
# depense ton credit.
OPENAI_API_KEY=sk-remplace-par-ta-cle
